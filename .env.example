# Copiar a .env y reemplazar los valores antes de iniciar Docker Compose.
# Nunca subir .env. Usar una base nueva para las migraciones corregidas.
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_CLAVE_DE_MYSQL
# Clave aleatoria de al menos 32 bytes, codificada en Base64; igual para Auth y Gateway.
JWT_SECRET=REEMPLAZAR_CON_CLAVE_ALEATORIA_BASE64
# Acceso renovable de 15 minutos, con un máximo absoluto de sesión de 24 horas.
JWT_EXPIRATION=900000
JWT_SESSION_DURATION=86400000
# Solo se usa al crear admin@library.cl por primera vez; mínimo 12 caracteres.
ADMIN_INITIAL_PASSWORD=REEMPLAZAR_CON_CLAVE_ADMIN_UNICA
# Puerto público y orígenes del frontend (ajustar si Vite usa otro puerto).
GATEWAY_PORT=8080
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
